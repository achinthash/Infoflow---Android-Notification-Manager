<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:colorBackground">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:elevation="0dp"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        app:title="Terms &amp; Conditions"
        app:titleTextColor="?attr/colorOnPrimary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="By installing or using InfoFlow, you agree to these Terms &amp; Conditions. If you do not agree with these terms, please do not use the application."
                android:textSize="16sp"
                android:lineSpacingExtra="5dp"
                android:textColor="?android:textColorPrimary"
                android:layout_marginBottom="28dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Use of the Application"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="InfoFlow is provided as a notification management tool. You may use the application to view, organize, search, and manage notification information available through Android's notification system."
                android:textSize="15sp"
                android:lineSpacingExtra="5dp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Notification Access"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Some InfoFlow features require Android Notification Access.\n\nYou are responsible for deciding which permissions you grant to InfoFlow.\n\nBy enabling Notification Access, you authorize InfoFlow to process the notifications made available through that Android permission."
                android:textSize="15sp"
                android:lineSpacingExtra="5dp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. User Responsibility"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="You are responsible for the information contained in notifications displayed or stored by InfoFlow.\n\nYou should not use InfoFlow to access, store, or distribute information that you are not authorized to access."
                android:textSize="15sp"
                android:lineSpacingExtra="5dp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4. Application Availability"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="InfoFlow may be updated, changed, suspended, or discontinued at any time.\n\nSome features may not work on every Android device because manufacturers may implement Android system features differently."
                android:textSize="15sp"
                android:lineSpacingExtra="5dp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="5. Data Deletion"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="You can delete notification information stored by InfoFlow using the available deletion features within the application."
                android:textSize="15sp"
                android:lineSpacingExtra="5dp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="6. Third-Party Applications"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="InfoFlow may display information originating from third-party applications.\n\nInfoFlow does not control the content, availability, or behavior of those third-party applications."
                android:textSize="15sp"
                android:lineSpacingExtra="5dp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="7. Disclaimer"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="InfoFlow is provided for notification management purposes. We do not guarantee that every notification will always be captured, stored, displayed, or restored correctly."
                android:textSize="15sp"
                android:lineSpacingExtra="5dp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="8. Changes to These Terms"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="These Terms &amp; Conditions may be updated when the application or its services change."
                android:textSize="15sp"
                android:lineSpacingExtra="5dp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="9. Contact"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="If you have questions about these Terms &amp; Conditions, please contact the InfoFlow developer through the contact information provided in the app."
                android:textSize="15sp"
                android:lineSpacingExtra="5dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Last updated: September 19, 2026"
                android:textSize="13sp"
                android:textColor="?android:textColorSecondary"
                android:layout_marginTop="24dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>