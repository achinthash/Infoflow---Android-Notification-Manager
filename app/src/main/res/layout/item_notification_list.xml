<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:paddingStart="15dp"
    android:paddingEnd="15dp">

    <!-- Notification image -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/img_large_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="centerCrop"
        android:contentDescription="Notification image"
        android:background="@android:color/transparent"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Time -->
    <TextView
        android:id="@+id/txt_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="12sp"
        android:singleLine="true"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/img_large_icon" />

    <!-- Unread indicator -->
    <ImageView
        android:id="@+id/img_unreadIndicator"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:contentDescription="Unread"
        android:visibility="gone"

        app:layout_constraintEnd_toStartOf="@id/txt_time"
        app:layout_constraintTop_toTopOf="@id/txt_time"
        app:layout_constraintBottom_toBottomOf="@id/txt_time"
        android:layout_marginEnd="8dp" />

    <!-- Title -->
    <TextView
        android:id="@+id/txt_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text=""
        android:textSize="15sp"
        android:textStyle="bold"

        app:layout_constraintStart_toEndOf="@id/img_large_icon"
        app:layout_constraintEnd_toStartOf="@id/img_unreadIndicator"
        app:layout_constraintTop_toTopOf="@id/img_large_icon" />

    <!-- Notification text -->
    <TextView
        android:id="@+id/txt_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="15dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text=""
        android:textSize="13sp"

        app:layout_constraintStart_toEndOf="@id/img_large_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txt_title" />

    <!-- Divider -->
    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="#454550"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>